// ============================================================================
// NQ Mini Futures — Liquidity Grab + FVG Retest Strategy
// ----------------------------------------------------------------------------
// Chart     : NQ1! or MNQ1!  |  Timeframe: 1 min
//
// Logic:
//   1. DETECT 4H Liquidity Grab
//        Bullish grab : prev 4H bar wicked BELOW prior 4H low (swept sell
//                       stops) then closed BACK ABOVE it → reversal up
//        Bearish grab : prev 4H bar wicked ABOVE prior 4H high (swept buy
//                       stops) then closed BACK BELOW it → reversal down
//
//   2. FIND 1-min FVG in the reversal direction
//        Bullish FVG  : gap above VWAP, impulse volume confirmed, width ≤ max
//        Bearish FVG  : gap below VWAP, impulse volume confirmed, width ≤ max
//
//   3. ENTER on the FVG retest (price returns to FVG zone)
//
//   4. EXIT
//        Initial SL   : below FVG bottom (long) / above FVG top (short)
//        Breakeven trail: once +5 pts in profit, stop moves to entry and
//                         continues trailing 5 pts behind the high/low
//                         No fixed TP — let the move run
// ============================================================================

//@version=5
strategy("NQ — Liquidity Grab + FVG Strategy",
     overlay           = true,
     default_qty_type  = strategy.fixed,
     default_qty_value = 1,
     commission_type   = strategy.commission.cash_per_contract,
     commission_value  = 2.0,
     slippage          = 1)

// ── Inputs ───────────────────────────────────────────────────────────────────
vol_period   = input.int(20,  "Volume MA Period",           minval=5,    group="Filters")
max_fvg_size = input.float(8, "Max FVG Width (points)",     minval=0.25, step=0.25, group="Filters",
     tooltip="Skip FVGs wider than this to keep SL bounded.")

sess_start   = input.int(930,  "Session Start (HHMM, ET)",  group="Session")
sess_end     = input.int(1530, "Session End   (HHMM, ET)",  group="Session")

sl_buf       = input.float(2,  "SL buffer beyond FVG (pts)", minval=0.25, step=0.25, group="Exits")
be_pts       = input.float(5,  "Breakeven trail activation (pts)", minval=0.25, step=0.25, group="Exits",
     tooltip="Once trade is up this many points, stop moves to breakeven and trails 5pts behind the high/low.")

// ── 4H OHLC (last two completed 4H bars) ────────────────────────────────────
[h4_h1, h4_l1, h4_c1] = request.security(syminfo.tickerid, "240",
     [high[1], low[1], close[1]], lookahead=barmerge.lookahead_on)

[h4_h2, h4_l2] = request.security(syminfo.tickerid, "240",
     [high[2], low[2]], lookahead=barmerge.lookahead_on)

// ── 4H Liquidity Grab ────────────────────────────────────────────────────────
// Bullish: prev 4H wicked below prior 4H low → closed back above it
bull_grab = h4_l1 < h4_l2 and h4_c1 > h4_l2

// Bearish: prev 4H wicked above prior 4H high → closed back below it
bear_grab = h4_h1 > h4_h2 and h4_c1 < h4_h2

// ── Indicators ───────────────────────────────────────────────────────────────
vwap_val = ta.vwap(hlc3)
avg_vol  = ta.sma(volume, vol_period)

// ── Session filter ────────────────────────────────────────────────────────────
bar_hm     = hour * 100 + minute
in_session = bar_hm >= sess_start and bar_hm < sess_end

// ── 1-min FVG Detection ───────────────────────────────────────────────────────
bull_fvg_now  = low > high[2]
bull_fvg_top  = low
bull_fvg_bot  = high[2]
bull_fvg_size = bull_fvg_top - bull_fvg_bot

bear_fvg_now  = high < low[2]
bear_fvg_top  = low[2]
bear_fvg_bot  = high
bear_fvg_size = bear_fvg_top - bear_fvg_bot

// ── Validate FVG: must align with 4H grab + VWAP + volume ────────────────────
bull_valid = bull_fvg_now
     and bull_grab                      // 4H bullish liquidity grab active
     and bull_fvg_size <= max_fvg_size  // narrow FVG — SL stays bounded
     and volume[1]     >= avg_vol       // impulse candle volume confirmed
     and bull_fvg_bot  >= vwap_val      // FVG above VWAP
     and in_session

bear_valid = bear_fvg_now
     and bear_grab
     and bear_fvg_size <= max_fvg_size
     and volume[1]     >= avg_vol
     and bear_fvg_top  <= vwap_val      // FVG below VWAP
     and in_session

// ── Store most recent valid FVG ───────────────────────────────────────────────
var float b_top = na
var float b_bot = na
var bool  b_on  = false
var int   b_bar = na

var float s_top = na
var float s_bot = na
var bool  s_on  = false
var int   s_bar = na

no_pos = strategy.position_size == 0

if bull_valid and no_pos
    b_top := bull_fvg_top
    b_bot := bull_fvg_bot
    b_on  := true
    b_bar := bar_index

if bear_valid and no_pos
    s_top := bear_fvg_top
    s_bot := bear_fvg_bot
    s_on  := true
    s_bar := bar_index

// Invalidate if price closes through the FVG (mitigated)
if b_on and close < b_bot
    b_on := false
if s_on and close > s_top
    s_on := false

// ── Entry: retest of FVG zone ─────────────────────────────────────────────────
long_entry  = b_on and no_pos and bar_index > b_bar and low  <= b_top and close >= b_bot
short_entry = s_on and no_pos and bar_index > s_bar and high >= s_bot and close <= s_top

var float long_sl  = na
var float short_sl = na

if long_entry
    long_sl  := b_bot - sl_buf
    b_on     := false
    strategy.entry("Long", strategy.long)

if short_entry
    short_sl  := s_top + sl_buf
    s_on      := false
    strategy.entry("Short", strategy.short)

// ── Exit: FVG-based initial SL + breakeven trail after be_pts ────────────────
// trail_points = activation: once price moves be_pts in profit
// trail_offset = trail distance: stop trails be_pts behind the extreme
// At the moment of activation: stop = entry (breakeven), then follows price
be_ticks = math.round(be_pts / syminfo.mintick)

strategy.exit("XL", "Long",  stop=long_sl,  trail_points=be_ticks, trail_offset=be_ticks)
strategy.exit("XS", "Short", stop=short_sl, trail_points=be_ticks, trail_offset=be_ticks)

// Flatten at session end
if bar_hm >= sess_end and strategy.position_size != 0
    strategy.close_all(comment="Session End")

// ── Visuals ──────────────────────────────────────────────────────────────────
// 4H reference: previous completed 4H bar's high and low
plot(h4_h1, "4H High", color=color.new(color.red,   40), linewidth=1, style=plot.style_stepline)
plot(h4_l1, "4H Low",  color=color.new(color.green, 40), linewidth=1, style=plot.style_stepline)
plot(vwap_val, "VWAP", color=color.blue, linewidth=2)

// Background highlight when a grab is active
bgcolor(bull_grab and in_session ? color.new(color.green, 93) : na, title="Bullish Grab Window")
bgcolor(bear_grab and in_session ? color.new(color.red,   93) : na, title="Bearish Grab Window")

// FVG boxes
if bull_valid
    box.new(bar_index[2], bull_fvg_top, bar_index + 30, bull_fvg_bot,
         border_color=color.new(color.green, 20),
         bgcolor=color.new(color.green, 80), border_width=1)

if bear_valid
    box.new(bar_index[2], bear_fvg_top, bar_index + 30, bear_fvg_bot,
         border_color=color.new(color.red, 20),
         bgcolor=color.new(color.red, 80), border_width=1)

// Entry signals
plotshape(long_entry,
     style=shape.triangleup, location=location.belowbar,
     color=color.lime, size=size.normal, title="Long Entry")

plotshape(short_entry,
     style=shape.triangledown, location=location.abovebar,
     color=color.red, size=size.normal, title="Short Entry")
