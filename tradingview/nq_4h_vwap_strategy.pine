// ============================================================================
// NQ Mini Futures — 4H VWAP Strategy
// ----------------------------------------------------------------------------
// Chart  : NQ1! or MNQ1!  |  Timeframe: 4H
// Entry  : At open of each 4H candle when prev candle closes above/below VWAP
//          AND prev candle volume >= 20-bar average volume
// Exit   : +10 pts take profit  |  5 pt trailing stop  |  End-of-bar close
// ============================================================================

//@version=5
strategy("NQ 4H VWAP Strategy",
     overlay           = true,
     default_qty_type  = strategy.fixed,
     default_qty_value = 1,
     commission_type   = strategy.commission.cash_per_contract,
     commission_value  = 2.0,
     slippage          = 2)

// ── Inputs ───────────────────────────────────────────────────────────────────
vol_period = input.int(20,   "Volume MA Period",     minval=5,    group="Filters")
tp_pts     = input.float(10, "Take Profit (points)", minval=0.25, step=0.25, group="Exits")
trail_pts  = input.float(5,  "Trail Stop (points)",  minval=0.25, step=0.25, group="Exits")

// ── Indicators ───────────────────────────────────────────────────────────────
vwap_val = ta.vwap(hlc3)
avg_vol  = ta.sma(volume, vol_period)

// ── Signals (evaluated at bar close → entry fires at NEXT bar open) ──────────
no_pos       = strategy.position_size == 0
vol_ok       = volume >= avg_vol

long_signal  = no_pos and vol_ok and close > vwap_val
short_signal = no_pos and vol_ok and close < vwap_val

// ── Entries ──────────────────────────────────────────────────────────────────
strategy.entry("Long",  strategy.long,  when=long_signal)
strategy.entry("Short", strategy.short, when=short_signal)

// ── Exits: Take Profit + Trailing Stop ───────────────────────────────────────
// trail_points activates after price moves trail_pts in our favour,
// then trails 5 pts below the highest price reached (long) or above lowest (short)
tp_ticks    = math.round(tp_pts   / syminfo.mintick)
trail_ticks = math.round(trail_pts / syminfo.mintick)

strategy.exit("XL", "Long",  profit=tp_ticks, trail_points=trail_ticks)
strategy.exit("XS", "Short", profit=tp_ticks, trail_points=trail_ticks)

// ── Time Exit: flatten at end of entry bar ───────────────────────────────────
strategy.close_all(when=barstate.isconfirmed, comment="EOB")

// ── Visuals ──────────────────────────────────────────────────────────────────
plot(vwap_val, "VWAP", color=color.blue, linewidth=2)

plotshape(long_signal,
     style    = shape.triangleup,
     location = location.belowbar,
     color    = color.new(color.green, 0),
     size     = size.small,
     title    = "Long Signal")

plotshape(short_signal,
     style    = shape.triangledown,
     location = location.abovebar,
     color    = color.new(color.red, 0),
     size     = size.small,
     title    = "Short Signal")

// Highlight bars with above-average volume
barcolor(vol_ok ? color.new(color.orange, 75) : na, title="High Volume Bar")
